<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Some OEM builds (OPPO/ColorOS) cancel Android's reader mode and
                 re-dispatch the tag as a plain TAG_DISCOVERED intent instead of
                 handing it to the reader callback. Declaring the filter lets this
                 activity catch that dispatch, so the scanner keeps working on
                 those devices. -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intfc.category.DEFAULT" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NFC tag reading (Mifare Classic cards). Normal-level permission: it
         is granted at install time and does not need a runtime prompt. -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- The scanner is optional: the app still installs on devices without
         NFC hardware and the record-keeping part keeps working there. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
