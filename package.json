{
  "name": "tuman-attendance-hybrid",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:sync": "ng build --configuration android && cap sync android",
    "build:android": "ng build --configuration android",
    "build:web": "ng build --configuration production",
    "build": "ng build",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "emulators": "firebase emulators:start --project tuman-attendance-demo --import ./.emulator-data --export-on-exit ./.emulator-data",
    "emulators:clean": "firebase emulators:start --project tuman-attendance-demo",
    "lint": "ng lint",
    "ng": "ng",
    "seed": "node tools/seed.mjs",
    "seed:emulator": "node tools/seed.mjs --emulator",
    "start": "ng serve",
    "test": "npm run test:unit",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:unit": "ng test --watch=false",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-nfc": "^8.3.4",
    "@ionic/angular": "^9.0.0",
    "@ionic/pwa-elements": "^3.4.0",
    "firebase": "^13.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "An Ionic project"
}
